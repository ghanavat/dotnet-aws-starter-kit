{
  "$schema": "http://json.schemastore.org/template",
  "author": "Saeed Ghanavat",
  "classifications": [
    "Common",
    "WebApi",
    "ClassLibrary",
    "xUnit"
  ],
  "name": "Ghanavats AWS Clean Architecture Starter Kit Template",
  "description": "A deployable .NET Clean Architecture template featuring AWS Lambda, API Gateway, DynamoDB and Infrastructure as Code using AWS CDK.",
  "identity": "Ghanavats.DotnetAws.StarterKit.Template",
  "shortName": "ghanavats_dotnet_aws_starter",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Ghanavats.DotnetAws",
  "preferNameDirectory": true,
  "primaryOutputs": [
    {
      "path": "Ghanavats.DotnetAws.StarterKit.sln"
    }
  ],
  "postActions": [
    {
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "description": "Restore NuGet packages required by this project.",
      "condition": "(!skipRestore)",
      "continueOnError": true,
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ]
    }
  ],
  "symbols": {
    "architecture": {
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "clean-arc",
      "description": "Select the application architecture.",
      "choices": [
        {
          "choice": "clean-arc",
          "description": "Multi-project Clean Architecture"
        },
        {
          "choice": "vertical-slice",
          "description": "Single-project Vertical Slice Architecture"
        }
      ]
    },
    "include-opentelemetry": {
      "type": "parameter",
      "datatype": "bool",
      "description": "Whether to include OpenTelemetry support in the project",
      "defaultValue": "true"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "(architecture == 'clean-arc')",
          "exclude": [
            "src/Presentation/Features/**/*"
          ]
        },
        {
          "condition": "(architecture == 'vertical-slice')",
          "exclude": [
            "src/Application/**/*",
            "src/Core/**/*",
            "src/Framework/Ghanavats.CleanArchitecture.Infrastructure/**/*",
            "src/Shared/**/*"
          ]
        }
      ]
    }
  ]
}
