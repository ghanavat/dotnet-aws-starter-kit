{
  "$schema": "http://json.schemastore.org/template",
  "author": "Saeed Ghanavat",
  "classifications": [
    "Common",
    "WebApi",
    "ClassLibrary",
    "xUnit"
  ],
  "name": "Ghanavats .NET on AWS Starter Kit",
  "description": "A deployable .NET template featuring AWS Lambda, API Gateway, DynamoDB and Infrastructure as Code using AWS CDK.",
  "identity": "Ghanavats.DotnetAws.StarterKit.Template",
  "shortName": "ghanavats_dotnet_aws_starter",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "sourceName": "Ghanavats.DotnetAws",
  "preferNameDirectory": true,
  "primaryOutputs": [
    {
      "path": "Ghanavats.DotnetAws.sln"
    }
  ],
  "SpecialCustomOperations": {
    "*.md": {
      "Operations": [
        {
          "type": "conditional",
          "configuration": {
            "if": [ "<!--#if" ],
            "else": [ "<!--#else" ],
            "elseif": [ "<!--#elseif" ],
            "endif": [ "<!--#endif" ],
            "actionableIf": [ "<!----#if" ],
            "actionableElse": [ "<!----#else" ],
            "actionableElseif": [ "<!----#elseif" ],
            "actions": [ "cStyleUncomment", "cStyleReduceComment" ],
            "trim": true,
            "wholeLine": true,
            "evaluator": "C++"
          }
        }
      ]
    }
  },
  "symbols": {
    "architecture": {
      "displayName": "Application Architecture",
      "type": "parameter",
      "datatype": "choice",
      "defaultValue": "clean-arc",
      "description": "Select the application architecture.",
      "choices": [
        {
          "choice": "clean-arc",
          "displayName": "Clean Architecture",
          "description": "Multi-project Clean Architecture"
        },
        {
          "choice": "vertical-slice",
          "displayName": "Vertical Slice Architecture",
          "description": "Single-project Vertical Slice Architecture"
        }
      ]
    },
    "addReadme": {
      "displayName": "Include README.md",
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": true,
      "description": "Include a README.md file in the generated solution."
    },
    "featureNamespaceSegment": {
      "type": "generated",
      "generator": "switch",
      "datatype": "string",
      "replaces": "__FEATURE_NAMESPACE__",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          {
            "condition": "(architecture == 'clean-arc')",
            "value": "UseCases"
          },
          {
            "condition": "(architecture == 'vertical-slice')",
            "value": "Api.Features"
          }
        ]
      }
    },
    "useCasesContractToApiFeaturesNamespaceSegment": {
      "type": "generated",
      "generator": "switch",
      "datatype": "string",
      "replaces": "__USECASES_CONTRACT_TO_API_FEATURE_NAMESPACE__",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          {
            "condition": "(architecture == 'clean-arc')",
            "value": "UseCases.Contracts"
          },
          {
            "condition": "(architecture == 'vertical-slice')",
            "value": "Api.Features.GetPersonDetails.Repositories"
          }
        ]
      }
    },
    "infraToFeatureNamespaceSegment": {
      "type": "generated",
      "generator": "switch",
      "datatype": "string",
      "replaces": "__INFRA_TO_FEATURE_NAMESPACE__",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          {
            "condition": "(architecture == 'clean-arc')",
            "value": "Infrastructure"
          },
          {
            "condition": "(architecture == 'vertical-slice')",
            "value": "Api.Features.GetPersonDetails"
          }
        ]
      }
    },
    "infraToApiNamespaceSegment": {
      "type": "generated",
      "generator": "switch",
      "datatype": "string",
      "replaces": "__INFRA_TO_API_NAMESPACE__",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          {
            "condition": "(architecture == 'clean-arc')",
            "value": "Infrastructure"
          },
          {
            "condition": "(architecture == 'vertical-slice')",
            "value": "Api"
          }
        ]
      }
    },
    "domainNamespaceSegment": {
      "type": "generated",
      "generator": "switch",
      "datatype": "string",
      "replaces": "__ENTITIES_NAMESPACE__",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          {
            "condition": "(architecture == 'clean-arc')",
            "value": "Core.Entities"
          },
          {
            "condition": "(architecture == 'vertical-slice')",
            "value": "Api.DomainEntities"
          }
        ]
      }
    },
    "useCasesTestsNamespaceSegment": {
      "type": "generated",
      "generator": "switch",
      "datatype": "string",
      "replaces": "__USECASES_TO_API_NAMESPACE__",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          {
            "condition": "(architecture == 'clean-arc')",
            "value": "UseCases"
          },
          {
            "condition": "(architecture == 'vertical-slice')",
            "value": "Api"
          }
        ]
      }
    },
    "publicToInternalAccessModifier": {
      "type": "generated",
      "generator": "switch",
      "datatype": "string",
      "replaces": "public /*__PUBLIC_TO_INTERNAL_ACCESS__*/",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          {
            "condition": "(architecture == 'clean-arc')",
            "value": "internal"
          },
          {
            "condition": "(architecture == 'vertical-slice')",
            "value": "public"
          }
        ]
      }
    },
    "internalToPublicAccessModifier": {
      "type": "generated",
      "generator": "switch",
      "datatype": "string",
      "replaces": "internal /*__INTERNAL_TO_PUBLIC_ACCESS__*/",
      "parameters": {
        "evaluator": "C++",
        "cases": [
          {
            "condition": "(architecture == 'clean-arc')",
            "value": "internal"
          },
          {
            "condition": "(architecture == 'vertical-slice')",
            "value": "public"
          }
        ]
      }
    }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "modifiers": [
        {
          "condition": "(architecture == 'clean-arc')",
          "exclude": [
            "src/Presentation/Ghanavats.DotnetAws.Api/Features/**/*",
            "src/Presentation/Ghanavats.DotnetAws.Api/DependencyInjection/**/*",
            "README.md"
          ],
          "rename": {
            "README.DotnetAwsTemplate.md": "README.md"
          }
        },
        {
          "condition": "(architecture == 'vertical-slice')",
          "exclude": [
            "src/Application/Ghanavats.DotnetAws.UseCases/**/*",
            "src/Core/Ghanavats.DotnetAws.Core/**/*",
            "src/Framework/Ghanavats.DotnetAws.Infrastructure/**/*",
            "src/Shared/Ghanavats.DotnetAws.Shared/**/*",
            "tests/Ghanavats.DotnetAws.ArchitectureTests/**/*",
            "tests/Ghanavats.DotnetAws.Core.Tests/**/*",
            "tests/Ghanavats.DotnetAws.Infrastructure.Tests/**/*",
            "tests/Ghanavats.DotnetAws.Shared.Tests/**/*",
            "tests/Ghanavats.DotnetAws.UseCases.Tests/**/*",
            "README.md"
          ],
          "rename": {
            "README.DotnetAwsTemplate.md": "README.md"
          }
        },
        {
          "condition": "(addReadme == false)",
          "exclude": [
            "README.DotnetAwsTemplate.md"
          ]
        }
      ]
    },
    {
      "condition": "(architecture == 'vertical-slice')",
      "source": "./src/Application/Ghanavats.DotnetAws.UseCases/GetPersonDetails/",
      "target": "./src/Presentation/Ghanavats.DotnetAws.Api/Features/GetPersonDetails/"
    },
    {
      "condition": "(architecture == 'vertical-slice')",
      "source": "./src/Application/Ghanavats.DotnetAws.UseCases/Contracts/",
      "target": "./src/Presentation/Ghanavats.DotnetAws.Api/Features/GetPersonDetails/Repositories/"
    },
    {
      "condition": "(architecture == 'vertical-slice')",
      "source": "./src/Framework/Ghanavats.DotnetAws.Infrastructure/Repositories/",
      "target": "./src/Presentation/Ghanavats.DotnetAws.Api/Features/GetPersonDetails/Repositories/"
    },
    {
      "condition": "(architecture == 'vertical-slice')",
      "source": "./src/Core/Ghanavats.DotnetAws.Core/Entities/",
      "target": "./src/Presentation/Ghanavats.DotnetAws.Api/DomainEntities/"
    },
    {
      "condition": "(architecture == 'vertical-slice')",
      "source": "./src/Framework/Ghanavats.DotnetAws.Infrastructure/DynamoDbModels/",
      "target": "./src/Presentation/Ghanavats.DotnetAws.Api/DynamoDbModels/"
    },
    {
      "condition": "(architecture == 'vertical-slice')",
      "source": "./tests/Ghanavats.DotnetAws.UseCases.Tests/GetPersonDetailsTests/",
      "target": "./tests/Ghanavats.DotnetAws.Api.Tests/GetPersonDetailsTests/"
    },
    {
      "condition": "(architecture == 'vertical-slice')",
      "source": "./tests/Ghanavats.DotnetAws.Infrastructure.Tests/RepositoryTests/",
      "target": "./tests/Ghanavats.DotnetAws.Api.Tests/RepositoryTests/"
    }
  ],
  "postActions": [
    {
      "actionId": "210D431B-A78B-4D2F-B762-4ED3E3EA9025",
      "description": "Restore NuGet packages required by this project.",
      "condition": "(!skipRestore)",
      "continueOnError": false,
      "manualInstructions": [
        {
          "text": "Run 'dotnet restore'"
        }
      ]
    }
  ]
}
